APP_MASTER_KEY=change-me-to-a-random-32-byte-string!!
# APP_MASTER_KEY_PREVIOUS=
# RUNEXIS_BASE_URL=https://didapi.runexis.ru
# Runexis and SMSC credentials: Admin → Settings, not env
SEED_ADMIN_EMAIL=admin@finenumbers.local
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=Administrator
COOKIE_SECURE=true
ADMIN_HOST=admin.sms.localhost
CLIENT_HOST=client.sms.localhost
API_HOST=api.sms.localhost
# Portainer (prod): only APP_MASTER_KEY, POSTGRES_PASSWORD, ADMIN_HOST, CLIENT_HOST, API_HOST.
# Image defaults to ghcr.io/finenumbers/sms:latest — see docs/deploy/PORTAINER.md
# CORS_ALLOW_ORIGINS=https://app.example
# API_KEY_PEPPER=
POSTGRES_USER=sms
POSTGRES_PASSWORD=sms
POSTGRES_DB=sms
# BACKUP_KEEP_DAYS=7
# BACKUP_INTERVAL_SECONDS=86400
